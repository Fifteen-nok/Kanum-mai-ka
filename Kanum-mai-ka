<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600&family=Noto+Sans+Thai:wght@300;400;500;600&family=Noto+Serif+Thai:wght@400;500;600&display=swap">
<style>
:root{
  color-scheme:dark;
  --bg:#0D090B;
  --surface:#1A1117;
  --ink:#F8EEF1;
  --muted:#BBA6AE;
  --pink:#F0528A;
  --pink-deep:#C72C61;
  --pink-soft:#2B1220;
  --pink-wash:#150D12;
  --gold:#C9A04A;
  --gold-line:#5A4620;
  --gold-text:#E3C98B;
  --sans:'Noto Sans Thai',system-ui,sans-serif;
  --serif:'Noto Serif Thai',serif;
  --script:'Cormorant Garamond',serif;
  --gutter:32px;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-text-size-adjust:100%}
a{color:inherit;text-decoration:none}
a:hover{filter:brightness(.94)}
a:focus-visible{outline:3px solid var(--gold-text);outline-offset:3px}
h1,h2,p{margin:0}
.wrap{max-width:1200px;margin:0 auto;padding-inline:var(--gutter)}
.eyebrow{font-size:13px;font-weight:500;letter-spacing:.28em;color:var(--gold-text)}
.h2{font-family:var(--serif);font-weight:500;font-size:34px;line-height:1.4;text-wrap:balance}
.body{font-size:16px;font-weight:300;line-height:1.85;color:var(--muted)}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;font-weight:500}
.btn-pink{background:var(--pink-deep);color:#fff}
.btn-ink{background:var(--pink-deep);color:#fff}
.btn-line{border:1px solid var(--ink);color:var(--ink)}
.btn-sm{min-height:44px;padding:0 26px;font-size:15px}
.btn-lg{min-height:54px;padding:0 30px;font-size:17px}

/* header */
.site-header{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding-block:24px}
.logo{font-family:var(--script);font-style:italic;font-weight:600;font-size:32px;letter-spacing:.01em}
.rule{height:1px;background:var(--gold-line);max-width:1136px;width:calc(100% - 2*var(--gutter));margin:0 auto}

/* hero */
.hero{display:flex;flex-wrap:wrap;align-items:center;gap:56px;padding-block:72px 88px}
.hero-copy{flex:1 1 420px;min-width:0;display:flex;flex-direction:column;gap:26px}
.hero h1{font-family:var(--serif);font-weight:500;font-size:54px;line-height:1.3;text-wrap:balance}
.hero-lead{font-size:18px;font-weight:300;line-height:1.9;color:var(--muted);max-width:500px}
.cta-row{display:flex;flex-wrap:wrap;gap:14px;padding-top:8px}
.hero-art{flex:1 1 320px;min-width:0;display:flex;justify-content:center}
.arch{position:relative;width:100%;max-width:380px;aspect-ratio:4/5}
.arch::before,.arch::after{content:"";position:absolute;border-radius:999px 999px 0 0}
.arch::before{inset:0;background:var(--pink-soft)}
.arch::after{inset:14px -14px -14px 14px;border:1px solid var(--gold)}
.arch-words{position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;text-align:center;font-family:var(--serif);font-weight:500;font-size:44px}
.arch-words .hot{color:var(--pink)}
.arch-words i{width:36px;height:1px;background:var(--gold)}
.badge{position:absolute;z-index:2;right:-18px;bottom:-34px;width:128px;aspect-ratio:1;border-radius:50%;background:var(--pink-deep);color:#fff;border:1px solid var(--gold);outline:5px solid var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;line-height:1.15}
.badge small{font-size:14px;font-weight:500}
.badge b{font-family:var(--script);font-style:italic;font-weight:600;font-size:44px;line-height:1}
.badge span{font-size:13px;font-weight:500}

/* products */
.products{padding-block:24px 88px}
.products-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:28px 40px}
.products-head>div:first-child{display:flex;flex-direction:column;gap:14px;flex:1 1 360px;min-width:0}
.price-strip{display:flex;align-items:stretch;gap:14px}
.price{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-width:150px;padding:18px 24px;border:1px solid var(--gold);border-radius:4px}
.price.hot{background:var(--pink-deep);border-color:var(--pink-deep);color:#fff}
.price-n{font-family:var(--script);font-style:italic;font-weight:600;font-size:52px;line-height:1;color:var(--gold-text)}
.price.hot .price-n{color:#fff}
.price-u{font-size:14px;font-weight:500}
.price-or{align-self:center;font-size:14px;color:var(--muted)}
.grid-products{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:20px}
.pcard{border:1px solid var(--gold-line);border-radius:4px;background:var(--surface);overflow:hidden;transition:border-color .2s}
.pcard:hover{border-color:var(--gold)}
.pbtn{display:block;width:100%;padding:0;border:0;background:none;color:inherit;font:inherit;text-align:left;cursor:pointer}
.pbtn:focus-visible{outline:3px solid var(--gold-text);outline-offset:-3px}
.pshot{display:block;overflow:hidden;aspect-ratio:3/4;background:#000}
.pshot img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .4s}
.pbtn:hover .pshot img{transform:scale(1.04)}
.pinfo{display:flex;align-items:baseline;justify-content:space-between;gap:10px;padding:14px 16px}
.pname{font-weight:500;font-size:16px;line-height:1.4;min-width:0}
.pprice{flex:none;font-size:13px;font-weight:500;padding:3px 12px;border-radius:999px;background:var(--pink-deep);color:#fff;white-space:nowrap}
.dock{display:none}
.products-cta{display:flex;flex-wrap:wrap;align-items:center;gap:16px 24px}
.products-cta p{font-size:16px;font-weight:300;color:var(--muted)}

/* viewer */
dialog{border:1px solid var(--gold);border-radius:4px;background:var(--bg);color:var(--ink);padding:16px;max-width:min(92vw,520px);max-height:92vh}
dialog::backdrop{background:rgba(0,0,0,.82)}
dialog img{display:block;width:100%;max-height:72vh;object-fit:contain;background:#000}
dialog p{margin:14px 0 0;font-family:var(--serif);font-size:20px;font-weight:500;display:flex;justify-content:space-between;gap:12px}
dialog p span{font-family:var(--sans);font-size:15px;color:var(--gold-text)}
.vcta{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.vcta .btn{flex:1 1 150px;min-height:48px;font-size:16px}
.vnote{margin-top:10px!important;font-family:var(--sans)!important;font-size:14px!important;font-weight:300!important;color:var(--muted)}
.vclose{position:absolute;top:8px;right:8px;z-index:1;width:44px;height:44px;border-radius:50%;border:1px solid var(--gold);background:var(--bg);color:var(--ink);font-size:22px;line-height:1;cursor:pointer}

/* values */
.values{padding-block:24px 88px}
.stack-48{display:flex;flex-direction:column;gap:48px}
.grid-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:40px}
.value{display:flex;flex-direction:column;gap:14px;border-top:1px solid var(--gold);padding-top:28px}
.value .tag{font-family:var(--serif);font-weight:500;font-size:28px;color:var(--pink)}
.value .title{font-weight:500;font-size:18px}

/* audience */
.audience{background:var(--pink-wash);padding-block:80px}
.audience .wrap{display:flex;flex-wrap:wrap;gap:48px;align-items:center}
.audience-copy{flex:1 1 380px;min-width:0;display:flex;flex-direction:column;gap:18px}
.audience-copy p{font-size:17px;font-weight:300;line-height:1.9;color:var(--muted);max-width:500px}
.chips{flex:1 1 380px;min-width:0;display:flex;flex-wrap:wrap;gap:12px;list-style:none;margin:0;padding:0}
.chips li{padding:12px 22px;border-radius:999px;background:var(--surface);border:1px solid var(--gold-line);font-size:16px}

/* steps */
.steps{padding-block:88px}
.step{display:flex;flex-direction:column;gap:10px}
.step .n{font-family:var(--script);font-style:italic;font-weight:500;font-size:64px;line-height:1;color:var(--gold)}
.step .title{font-weight:500;font-size:18px}
.step .body{line-height:1.8}

/* contact */
.contact{background:var(--pink-deep);padding-block:88px;color:#fff}
.contact .wrap{display:flex;flex-direction:column;gap:40px}
.contact-head{display:flex;flex-direction:column;gap:12px}
.contact-head h2{font-family:var(--serif);font-weight:500;font-size:36px;line-height:1.4}
.contact-head p{font-size:17px;font-weight:300;line-height:1.8}
.contact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:24px}
.card{background:var(--bg);color:var(--ink);border:1px solid var(--gold);border-radius:4px;padding:36px;display:flex;flex-direction:column;min-width:0}
.card-line{gap:16px}
.card-call{gap:12px}
.card .line-id{font-family:var(--serif);font-weight:500;font-size:28px;overflow-wrap:anywhere}
.card .btn{align-self:flex-start}
.phone{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:54px;border-bottom:1px solid var(--gold-line);font-family:var(--serif);font-weight:500;font-size:22px}
.phone:last-child{border-bottom:0}
.phone span:last-child{font-family:var(--sans);font-size:15px;font-weight:400;color:var(--pink)}

/* footer */
.site-footer{padding:32px var(--gutter);display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px 28px;text-align:center;font-size:14px;color:var(--muted)}
.site-footer .logo{font-size:20px;color:var(--ink)}

@media (max-width:640px){
  :root{--gutter:20px}
  .hero{padding-block:48px 64px;gap:40px}
  .hero h1{font-size:40px}
  .h2,.contact-head h2{font-size:28px}
  .arch-words{font-size:36px}
  .values{padding-bottom:64px}
  .steps,.contact{padding-block:64px}
  .audience{padding-block:56px}
  .card{padding:28px 22px}
  .cta-row .btn,.products-cta .btn{width:100%}
  .products{padding-bottom:64px}
  .grid-products{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .pinfo{flex-direction:column;gap:2px;padding:10px 12px}
  .pname{font-size:14px}
  .price-strip{width:100%}
  .price{flex:1;min-width:0;padding:14px 12px}
  .badge{width:104px;right:-6px;bottom:-26px}
  .badge b{font-size:36px}
  body{padding-bottom:calc(76px + env(safe-area-inset-bottom,0px))}
  .dock{display:flex;gap:10px;position:fixed;left:0;right:0;bottom:0;z-index:20;padding:10px var(--gutter) calc(10px + env(safe-area-inset-bottom,0px));background:var(--bg);border-top:1px solid var(--gold)}
  .dock .btn{flex:1;min-height:52px;font-size:16px}
}
</style>
